{
  "name": "@aigc-flow/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts",
    "migrate:personal-wallets:dry-run": "tsx src/personal-wallet-migration-cli.ts --dry-run",
    "migrate:personal-wallets:write": "tsx src/personal-wallet-migration-cli.ts --write --confirm PERSONAL_WALLET_CUTOVER",
    "reconcile:legacy-reservations:dry-run": "tsx src/personal-wallet-reconciliation-cli.ts --dry-run",
    "reconcile:legacy-reservations:write": "tsx src/personal-wallet-reconciliation-cli.ts --write --confirm LEGACY_RESERVATION_RECONCILIATION",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
